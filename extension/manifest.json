{
  "manifest_version": 3,
  "name": "Packio Connect",
  "short_name": "Packio",
  "version": "0.3.0",
  "description": "Relie vos comptes Vinted et Vestiaire Collective à Packio : ventes, expéditions et bordereaux transmis à votre préparateur.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Packio Connect",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.be/*",
    "https://www.vinted.es/*",
    "https://www.vinted.it/*",
    "https://www.vinted.de/*",
    "https://www.vinted.com/*",
    "https://www.vestiairecollective.com/*",
    "https://apiv2.vestiairecollective.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
