{
  "name": "packio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/local.mjs",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:deploy": "prisma migrate deploy",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0",
    "prisma": "^6.19.0",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.57.0"
  }
}