# =============================================================================
# PACKIO — Variables d'environnement (copier en .env, ne jamais committer .env)
# Aucune de ces variables n'est exposée au navigateur.
# =============================================================================

# --- Application --------------------------------------------------------------
# URL publique (liens dans les e-mails, redirections Stripe, cookies sécurisés)
APP_URL="http://localhost:3000"

# --- Base de données PostgreSQL --------------------------------------------------
# Connexion utilisée par l'application (pooler recommandé en serverless)
DATABASE_URL="postgresql://packio:packio@localhost:5432/packio?schema=public"
# Connexion directe pour les migrations (facultatif, sinon DATABASE_URL)
# DIRECT_DATABASE_URL="postgresql://..."
# Chiffrement : "off", "require" ou "verify" (par défaut "require" pour Supabase, sinon "off")
# DATABASE_SSL="require"
# Connexions simultanées (bases gratuites : 5)
# DATABASE_POOL_MAX="10"

# --- Paiements (Whop) ------------------------------------------------------------
# "whop" en production. "dev" = paiements simulés (refusé si NODE_ENV=production)
BILLING_MODE="dev"
# Clé API du compte Whop (Developer → API keys) — serveur uniquement
WHOP_API_KEY=""
# Identifiant de l'entreprise Whop (biz_…)
WHOP_ACCOUNT_ID=""
# Produit Whop auquel rattacher les plans créés à la volée (prod_…), facultatif
WHOP_PRODUCT_ID=""
# Secret de signature du webhook /api/webhooks/whop (ws_…)
WHOP_WEBHOOK_SECRET=""
# "production" (défaut) ou "sandbox" (https://sandbox-api.whop.com)
WHOP_ENVIRONMENT="production"
# Version d'API figée (en-tête Api-Version-Date), facultatif
WHOP_API_VERSION_DATE=""

# --- E-mails transactionnels (Resend) ------------------------------------------
# Sans clé, les e-mails sont journalisés (table email_logs) sans être envoyés.
RESEND_API_KEY=""
EMAIL_FROM="Packio <notifications@votre-domaine.fr>"

# --- Stockage des fichiers ------------------------------------------------------
# "local" (développement) ou "s3" (production : Supabase Storage, Cloudflare R2, AWS S3, Scaleway…)
# Supabase : Storage → Settings → S3, endpoint https://<projet>.storage.supabase.co/storage/v1/s3
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Tâches planifiées ----------------------------------------------------------
# Secret de l'ordonnanceur (cron-job.org, Vercel Cron…) : en-tête Authorization: Bearer <CRON_SECRET>
# Ordonnanceur unique : GET /api/cron/toutes toutes les 10 à 15 minutes.
CRON_SECRET=""

# --- Données de démonstration (développement uniquement) ----------------------
# SEED_DEMO_PASSWORD="Demo-Packio-2026"

# --- Mise en ligne -----------------------------------------------------------
# Compte super administrateur créé par `npm run db:bootstrap` (lien d'activation
# affiché dans les journaux et envoyé par e-mail).
INITIAL_ADMIN_EMAIL=""
# Site de démonstration uniquement : crée les comptes de démo au déploiement.
# DEMO_DATA="1"
# Lien de l'extension Packio Connect sur le Chrome Web Store (bouton « Installer »).
EXTENSION_STORE_URL=""

# --- Lecture de secours de Packio Connect (facultatif) ----------------------
# La lecture automatique est gratuite et toujours active. En dernier recours,
# une IA : Google Gemini (offre gratuite, clé sur aistudio.google.com/apikey)
# ou Claude (payant). Données personnelles masquées avant l'envoi.
GEMINI_API_KEY=""
# AI_GEMINI_MODEL="gemini-3.5-flash-lite"
# ANTHROPIC_API_KEY=""
# AI_MONTHLY_BUDGET_USD="15"
# AI_DAILY_CALLS_PER_CUSTOMER="6"
